[Unit]
Description=Gateway-Kit sing-box (started only after confirmed apply)
After=network-online.target gateway-kit.service gateway-kit-forwarding.service
Requires=gateway-kit-forwarding.service
ConditionPathExists=/etc/gateway-kit/generated/sing-box.json
StartLimitIntervalSec=120
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/etc/gateway-kit/generated
ExecStart=/bin/sh -c 'bin=$(command -v sing-box) || bin=/usr/local/bin/sing-box; exec "$bin" run -c /etc/gateway-kit/generated/sing-box.json'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
